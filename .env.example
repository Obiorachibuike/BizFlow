# Copy this file to .env before starting Docker Compose. Replace every placeholder.
POSTGRES_DB=bizflow
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://bizflow:replace-with-a-long-random-password@db:5432/bizflow
SECRET_KEY=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:3000
BIZFLOW_API_URL=http://api:8000
